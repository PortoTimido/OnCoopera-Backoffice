# URL base opcional da API do backoffice.
VITE_API_BASE_URL=/api

# Chave pública do Google Maps para o seletor de localização do Radar de Apoio.
# Mantenha o valor real apenas no arquivo .env local.
VITE_GOOGLE_MAPS_API_KEY=

# Chave da Google Places API (New), usada para localizar as coordenadas do endereço.
VITE_GOOGLE_PLACES_API_KEY=
